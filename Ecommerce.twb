      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order_ID]) / TOTAL(COUNTD([Order_ID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_1993704007712768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/COUNT([Order_ID])' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_1993704015384577]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Customer type' datatype='string' name='[Calculation_1993704032043014]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [Customer_ID] : MIN([Order_Date]) } = [Order_Date]&#13;&#10;THEN &quot;New Customer&quot;&#13;&#10;ELSE &quot;Existing Customer&quot;&#13;&#10;END' />
      </column>
      <column caption='Title' datatype='string' name='[Calculation_1993704054599688]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Sales Analysis Dashboard&quot;' />
      </column>
      <column caption='Delivery Days' datatype='integer' name='[Calculation_3206194096488448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order_Date],[Delivery_Date])' />
      </column>
      <column caption='Delivery Performance' datatype='string' name='[Calculation_3206194100445185]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3206194096488448] &lt;= 3 THEN &quot;Fast&quot;&#13;&#10;ELSEIF [Calculation_3206194096488448] &lt;= 7 THEN &quot;Normal&quot;&#13;&#10;ELSE &quot;Delayed&quot;&#13;&#10;END' />
      </column>
      <column caption='Title_1' datatype='string' name='[Calculation_3206194441601029]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Customer Insights Dashboard&quot;' />
      </column>
      <column caption='Title_2' datatype='string' name='[Calculation_3206195541860358]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Product Performance&quot;' />
      </column>
      <column caption='Title_3' datatype='string' name='[Calculation_3206195542147079]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Delivery Analysis&quot;' />
      </column>
      <column caption='Title_4' datatype='string' name='[Calculation_3206195542396936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Payment &amp; Returns&quot;' />
      </column>
      <column caption='Title_main' datatype='string' name='[Calculation_3206195882532873]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;EcomLens – Business at a Glance&quot;' />
      </column>
      <column caption='Label' datatype='string' name='[Calculation_3206197187952650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Average Order Value&quot;' />
      </column>
      <column caption='Recency' datatype='integer' name='[Calculation_3206198320254987]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [Customer_ID] : MAX([Order_Date])}, TODAY())' />
      </column>
      <column caption='Frequency' datatype='integer' name='[Calculation_3206198320357388]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Customer_ID] : COUNTD([Order_ID])}' />
      </column>
      <column caption='Monetary' datatype='integer' name='[Calculation_3206198320508941]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Customer_ID] : SUM([Sales])}' />
      </column>
      <column caption='Recency Score ' datatype='integer' name='[Calculation_3206198321033230]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3206198320254987] &lt;= 110 THEN 5&#13;&#10;ELSEIF [Calculation_3206198320254987] &lt;= 232 THEN 4&#13;&#10;ELSEIF [Calculation_3206198320254987] &lt;= 379 THEN 3&#13;&#10;ELSEIF [Calculation_3206198320254987] &lt;= 531 THEN 2&#13;&#10;ELSE 1 END' />
      </column>
      <column caption='Frequency Score' datatype='integer' name='[Calculation_3206198321115151]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3206198320357388] = 1 THEN 1&#13;&#10;ELSEIF [Calculation_3206198320357388] = 2 THEN 3&#13;&#10;ELSE 5 END' />
      </column>
      <column caption='Monetary Score' datatype='integer' name='[Calculation_3206198321246224]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_3206198320508941] &lt;= 3402 THEN 1&#13;&#10;ELSEIF [Calculation_3206198320508941] &lt;= 6860 THEN 2&#13;&#10;ELSEIF [Calculation_3206198320508941] &lt;= 11259 THEN 3&#13;&#10;ELSEIF [Calculation_3206198320508941] &lt;= 17547 THEN 4&#13;&#10;ELSE 5 END' />
      </column>
      <column caption='Segment' datatype='string' name='[Calculation_3206198321410065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_3206198321033230]&gt;=4 AND [Calculation_3206198321115151]&gt;=3 AND [Calculation_3206198321246224]&gt;=4 THEN &quot;Champions&quot;&#13;&#10;ELSEIF [Calculation_3206198321033230]&gt;=3 AND [Calculation_3206198321246224]&gt;=3 THEN &quot;Loyal Customers&quot;&#13;&#10;ELSEIF [Calculation_3206198321033230]&lt;=2 AND [Calculation_3206198321115151]=1 THEN &quot;At Risk / One-time&quot;&#13;&#10;ELSE &quot;Regular&quot; END' />
      </column>
      <column caption='Churn Status' datatype='string' name='[Calculation_3206198322733074]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEDIFF(&apos;day&apos;, {FIXED [Customer_ID] : MAX([Order_Date])}, TODAY()) &gt; 90&#13;&#10;THEN &quot;Churned&quot;&#13;&#10;ELSE &quot;Active&quot; END' />
      </column>
      <column caption='Primary Segment' datatype='string' name='[Calculation_3206198334070803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED [Customer_ID] : MAX(&#13;&#10;    IF [Order_Date] = {FIXED [Customer_ID] : MAX([Order_Date])}&#13;&#10;    THEN [Customer_Segment]&#13;&#10;    END&#13;&#10;)}' />
      </column>
      <column caption='Date Granuality calc' datatype='datetime' name='[Calculation_3206198411792404]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;   WHEN &quot;Monthly&quot; THEN DATETRUNC(&apos;month&apos;, [Order_Date])&#13;&#10;   WHEN &quot;Quarterly&quot; THEN DATETRUNC(&apos;quarter&apos;, [Order_Date])&#13;&#10;   WHEN &quot;Yearly&quot; THEN DATETRUNC(&apos;year&apos;, [Order_Date])&#13;&#10;   END' />
      </column>
