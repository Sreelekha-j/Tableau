          </datasources>
          <datasource-dependencies datasource='federated.13xmbgl1n4kzu81gray4v055b9o7'>
            <column caption='Recency' datatype='integer' name='[Calculation_3206198320254987]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, {FIXED [Customer_ID] : MAX([Order_Date])}, TODAY())' />
            </column>
            <column caption='Frequency' datatype='integer' name='[Calculation_3206198320357388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Customer_ID] : COUNTD([Order_ID])}' />
            </column>
            <column caption='Monetary' datatype='integer' name='[Calculation_3206198320508941]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Customer_ID] : SUM([Sales])}' />
            </column>
            <column caption='Recency Score ' datatype='integer' name='[Calculation_3206198321033230]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3206198320254987] &lt;= 110 THEN 5&#13;&#10;ELSEIF [Calculation_3206198320254987] &lt;= 232 THEN 4&#13;&#10;ELSEIF [Calculation_3206198320254987] &lt;= 379 THEN 3&#13;&#10;ELSEIF [Calculation_3206198320254987] &lt;= 531 THEN 2&#13;&#10;ELSE 1 END' />
            </column>
            <column caption='Frequency Score' datatype='integer' name='[Calculation_3206198321115151]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3206198320357388] = 1 THEN 1&#13;&#10;ELSEIF [Calculation_3206198320357388] = 2 THEN 3&#13;&#10;ELSE 5 END' />
            </column>
            <column caption='Monetary Score' datatype='integer' name='[Calculation_3206198321246224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_3206198320508941] &lt;= 3402 THEN 1&#13;&#10;ELSEIF [Calculation_3206198320508941] &lt;= 6860 THEN 2&#13;&#10;ELSEIF [Calculation_3206198320508941] &lt;= 11259 THEN 3&#13;&#10;ELSEIF [Calculation_3206198320508941] &lt;= 17547 THEN 4&#13;&#10;ELSE 5 END' />
            </column>
            <column caption='Segment' datatype='string' name='[Calculation_3206198321410065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3206198321033230]&gt;=4 AND [Calculation_3206198321115151]&gt;=3 AND [Calculation_3206198321246224]&gt;=4 THEN &quot;Champions&quot;&#13;&#10;ELSEIF [Calculation_3206198321033230]&gt;=3 AND [Calculation_3206198321246224]&gt;=3 THEN &quot;Loyal Customers&quot;&#13;&#10;ELSEIF [Calculation_3206198321033230]&lt;=2 AND [Calculation_3206198321115151]=1 THEN &quot;At Risk / One-time&quot;&#13;&#10;ELSE &quot;Regular&quot; END' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Customer ID' datatype='string' name='[Customer_ID]' role='dimension' type='nominal' />
